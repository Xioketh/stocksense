# Copy this file to .env and change the values:  cp .env.example .env
# .env is in .gitignore — never commit real secrets.

APP_ENV=local
LOG_LEVEL=INFO

# Database (local Docker Postgres)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=stocksense
DB_USER=stocksense
DB_PASSWORD=change-me-local-password

# Clients must send this in the X-API-Key header
API_KEY=change-me-local-api-key

# Invoice uploads: "fake" works without Google Cloud; Cloud Run uses "gcs"
STORAGE_BACKEND=fake
INVOICES_BUCKET=

# LowStock events: "fake" keeps them in memory; Cloud Run uses "pubsub"
EVENTS_BACKEND=fake
GOOGLE_CLOUD_PROJECT=
LOW_STOCK_TOPIC=low-stock

# ---------- Assistant (services/assistant) ----------
# Clients of the ASSISTANT send this in X-API-Key. Use a different value from API_KEY.
ASSISTANT_API_KEY=change-me-local-assistant-key
# The assistant's own database on the same Postgres (checkpoints, embeddings).
ASSISTANT_DB_NAME=stocksense_assistant
# Where the assistant finds the API. Docker Compose overrides this with http://api:8080
# and sets STOCKSENSE_API_KEY from API_KEY, so you only need these outside Docker.
STOCKSENSE_API_URL=http://localhost:8000
STOCKSENSE_API_KEY=change-me-local-api-key

# Gemini through Google AI Studio (https://aistudio.google.com/apikey). Local only:
# Phase E switches to Vertex AI with a service account, no key.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# LangSmith tracing (https://smith.langchain.com). Off until A3.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=stocksense-assistant