# Copy this file to .env and change the values:  cp .env.example .env
# .env is in .gitignore — never commit real secrets.

APP_ENV=local
LOG_LEVEL=INFO

# Database (local Docker Postgres)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=stocksense
DB_USER=stocksense
DB_PASSWORD=change-me-local-password

# Clients must send this in the X-API-Key header
API_KEY=change-me-local-api-key

# Invoice uploads: "fake" works without Google Cloud; Cloud Run uses "gcs"
STORAGE_BACKEND=fake
INVOICES_BUCKET=

# LowStock events: "fake" keeps them in memory; Cloud Run uses "pubsub"
EVENTS_BACKEND=fake
GOOGLE_CLOUD_PROJECT=
LOW_STOCK_TOPIC=low-stock